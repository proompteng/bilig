{
  "$schema": "./node_modules/knip/schema.json",
  "rules": {
    "types": "off"
  },
  "ignoreIssues": {
    "packages/grid/src/useViewport.ts": ["duplicates"],
    "packages/wasm-kernel/assembly/**/*.ts": ["exports", "enumMembers"]
  },
  "workspaces": {
    ".": {
      "ignoreFiles": ["scripts/**"],
      "entry": [
        "actions/xlsx-cache-doctor/*.mjs",
        "docs/assets/hero-scene.js",
        "docs/assets/site-nav.js",
        "docs/external-workbook-recalc-proof.ts",
        "docs/formula-clinic-report.ts",
        "docs/npm-eval.ts",
        "docs/xlsx-recalculation-proof.ts",
        "e2e/tests/prod-smoke.pw.ts",
        "examples/headless-workpaper/*.ts",
        "examples/recalc-bridge-workflows/*.mjs",
        "examples/serverless-workpaper-api/*.ts",
        "examples/xlsx-cache-doctor-ci/scripts/*.ts",
        "examples/xlsx-recalculation-node/recalculate-xlsx.ts",
        "integrations/n8n-nodes-workpaper/.prettierrc.js",
        "integrations/n8n-nodes-workpaper/eslint.config.mjs",
        "integrations/n8n-nodes-workpaper/nodes/Workpaper/BiligWorkpaper.node.ts",
        "scripts/bench-worker-runtime.ts"
      ]
    },
    "packages/create-workpaper": {
      "entry": ["template/src/index.ts"]
    },
    "packages/bilig": {
      "entry": [
        "src/agent-workbook-challenge-bin.ts",
        "src/evaluator-bin.ts",
        "src/formula-clinic-bin.ts",
        "src/mcp-challenge-bin.ts",
        "src/work-paper-mcp-stdio-bin.ts"
      ]
    },
    "packages/bilig-xlsx-formula-recalc": {
      "entry": [
        "src/cache-doctor-cli.ts",
        "src/cli.ts",
        "src/evaluator-bin.ts",
        "src/sheetjs-cli.ts",
        "src/workbook-compatibility-report-cli.ts"
      ]
    },
    "packages/headless": {
      "entry": [
        "src/agent-start-bin.ts",
        "src/agent-workbook-challenge-bin.ts",
        "src/mcp-challenge-bin.ts",
        "src/n8n-forecast-server-bin.ts",
        "src/work-paper-mcp-stdio-bin.ts"
      ]
    },
    "packages/workpaper": {
      "entry": [
        "src/agent-start-bin.ts",
        "src/agent-workbook-challenge-bin.ts",
        "src/evaluator-bin.ts",
        "src/formula-clinic-bin.ts",
        "src/mcp-challenge-bin.ts",
        "src/n8n-forecast-server-bin.ts",
        "src/work-paper-mcp-stdio-bin.ts"
      ]
    },
    "packages/wasm-kernel": {
      "entry": ["assembly/index.ts"],
      "project": ["assembly/**/*.ts"],
      "ignoreDependencies": ["assemblyscript"]
    },
    "packages/xlsx-formula-recalc": {
      "entry": [
        "src/cache-doctor-cli.ts",
        "src/cli.ts",
        "src/evaluator-bin.ts",
        "src/sheetjs-cli.ts",
        "src/workbook-compatibility-report-cli.ts"
      ]
    }
  }
}
